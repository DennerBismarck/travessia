{
  "name": "travessia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "secret-scan": "tsx scripts/secret-scan.ts apps/web/.next",
    "contract": "tsx --env-file=.env.sandbox scripts/contract.ts",
    "mcp:smoke": "tsx --env-file=.env.sandbox scripts/mcp-smoke.ts",
    "e2e": "pnpm --filter @travessia/web e2e"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@travessia/hodle": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  }
}
